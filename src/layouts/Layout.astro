) : (
  <!-- HEADER (Inner pages) -->
  <header id="site-header">
    <div class="wrap hd-in">
      <a href="/" style="font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;color:var(--gold)">GOLDEN MAGIC MIRROR</a>
      <nav class="hd-nav">
        <a href="/#galerie">Galerie</a>
        <a href="/#magic">Ablauf</a>
