    <div class="mob-divider"></div>
    <a href="#magic" class="mob-link">Ablauf</a>
    <div class="mob-divider"></div>
    <a href="#pricing" class="mob-link">Preise</a>
    <div class="mob-divider"></div>
    <a href="#ausstattung" class="mob-link">Ausstattung</a>
    <div class="mob-divider"></div>
    <a href="#why" class="mob-link">Vorteile</a>
    <div class="mob-divider"></div>
