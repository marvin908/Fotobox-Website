---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
  isHome?: boolean;
}

const { title, description, robots = 'index,follow', isHome = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/>
<meta name="robots" content={robots}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content="https://wittmann-eventbox.at"/>
<meta property="og:image" content="https://wittmann-eventbox.at/gallery/Golden-Magic-Mirror-Spiegelfotobox-6.jpg"/>
<meta property="og:locale" content="de_AT"/>
<meta property="og:site_name" content="Wittmann Eventbox"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={title}/>
<meta name="twitter:description" content={description}/>
<meta name="twitter:image" content="https://wittmann-eventbox.at/gallery/Golden-Magic-Mirror-Spiegelfotobox-6.jpg"/>
<link rel="icon" type="image/png" href="/favicon.png"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@700,800&family=Mulish:wght@400,600,700&display=swap"/>

<!-- Consent Mode v2 — MUSS vor gtag laufen -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'wait_for_update': 500
  });
  gtag('set', 'url_passthrough', true);
  gtag('set', 'ads_data_redaction', true);
  try {
    var c = JSON.parse(localStorage.getItem('wb_consent') || 'null');
    if (c && c.ad_storage === 'granted') {
      gtag('consent', 'update', {
        'ad_storage': 'granted', 'ad_user_data': 'granted',
        'ad_personalization': 'granted', 'analytics_storage': 'granted'
      });
    }
  } catch(e){}
</script>

<!-- Google-Tag (lädt auf jeder Seite, auch /danke) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-10978741779"></script>
<script is:inline>
  gtag('js', new Date());
  gtag('config', 'AW-10978741779');
</script>
<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Wittmann Eventbox",
  "image": "https://wittmann-eventbox.at/gallery/Golden-Magic-Mirror-Spiegelfotobox-6.jpg",
  "@id": "https://wittmann-eventbox.at",
  "url": "https://wittmann-eventbox.at",
  "telephone": "+436604313993",
  "email": "wb@wittmann-eventbox.at",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Gustav-Mahler-Promenade 4/2/1",
    "addressLocality": "Stockerau",
    "postalCode": "2000",
    "addressCountry": "AT"
  },
  "areaServed": ["Wien", "Niederösterreich"],
  "description": "Golden Magic Mirror Spiegelfotobox-Vermietung für Hochzeiten, Geburtstage und Firmenfeiern in Wien und Niederösterreich. 500€ Festpreis, alles inklusive."
}
</script>
{isHome && <script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie lange dauert der Aufbau des Magic Mirrors?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Der Aufbau dauert in der Regel 30–45 Minuten. Wir kommen rechtzeitig vor Ihrem Event, damit alles bereit ist wenn Ihre Gäste eintreffen. Abbau und Abholung übernehmen wir ebenfalls – Sie müssen sich um nichts kümmern."
      }
    },
    {
      "@type": "Question",
      "name": "Ist die Buchung wirklich unverbindlich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, absolut. Wenn Sie das Formular absenden, bekommen Sie zunächst nur eine Rückmeldung von uns. Erst nach einem gemeinsamen Gespräch und Ihrer ausdrücklichen Bestätigung wird der Termin verbindlich reserviert."
      }
    },
    {
      "@type": "Question",
      "name": "Wie viele Gäste können den Spiegel gleichzeitig nutzen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vor dem Spiegel passen bequem 2–4 Personen gleichzeitig. Der Spiegel selbst ist großformatig, sodass auch Gruppenfotos wunderbar gelingen. Bei Gruppen über 4 Personen empfehlen wir zwei separate Aufnahmen für optimale Ergebnisse."
      }
    },
    {
      "@type": "Question",
      "name": "Was passiert mit den digitalen Fotos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Jede Aufnahme wird sofort ausgedruckt und kann per QR-Code auch digital abgerufen werden. Nach der Veranstaltung erhalten Sie auf Wunsch alle Fotos in einer digitalen Galerie – als schöne Erinnerung für Sie und Ihre Gäste."
      }
    },
    {
      "@type": "Question",
      "name": "Kann das Layout der Sofortdrucke personalisiert werden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja! Das Drucklayout kann mit Ihrem Namen, Datum, Logo oder einem individuellen Design versehen werden. So wird jeder Sofortdruck zu einem persönlichen Andenken an Ihr besonderes Event."
      }
    },
    {
      "@type": "Question",
      "name": "Wie weit fahren Sie für Events?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wir sind in Wien und der gesamten Umgebung für Sie da. Die Anfahrt ist in allen Paketen inklusive. Für Events außerhalb unseres regulären Einzugsgebiets sprechen Sie uns einfach an – wir finden eine Lösung."
      }
    }
  ]
}
</script>}
</head>
<body>

<header id="site-header" style="position:sticky;top:0;z-index:100;background:#0a0802;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid rgba(232,212,150,.1);padding:14px 0">
  <div class="wrap hd-in">
    <div class="hd-logo">
      <svg width="200" height="50" viewBox="0 0 200 50" xmlns="http://www.w3.org/2000/svg">
        <text x="2" y="48" font-family="Georgia,serif" font-size="58" font-weight="700" fill="rgba(255,255,255,0.08)" letter-spacing="-2">WB</text>
        <text x="2" y="38" font-family="Georgia,serif" font-size="36" font-weight="700" fill="#DDA844">W</text>
        <text x="38" y="38" font-family="Georgia,serif" font-size="36" font-weight="700" fill="#ffffff">B</text>
        <line x1="74" y1="8" x2="74" y2="44" stroke="rgba(221,170,68,0.4)" stroke-width="1"/>
        <text x="84" y="22" font-family="'Poppins',sans-serif" font-size="11" font-weight="800" fill="#DDA844" letter-spacing="1.8">WITTMANN</text>
        <text x="84" y="37" font-family="'Mulish',sans-serif" font-size="11" font-weight="600" fill="rgba(255,255,255,0.7)" letter-spacing="0.5">Eventbox</text>
        <text x="186" y="37" font-family="sans-serif" font-size="10" fill="rgba(221,170,68,0.6)">◆</text>
      </svg>
      <div style="font-family:'Mulish',sans-serif;font-size:10px;font-weight:400;color:rgba(255,255,255,0.4);letter-spacing:0.5px;margin-top:2px;text-align:left">Wittmann Bernhard</div>
    </div>
  </div>
</header>

<style is:global>
.hd-hamburger{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:40px;height:40px;background:none;border:none;cursor:pointer;padding:0;flex-shrink:0}
.hd-hamburger span{display:block;width:24px;height:2px;background:#DDA844;border-radius:2px;transition:transform .25s ease,opacity .25s ease}
.mob-overlay{position:fixed;inset:0;z-index:9999;background:rgba(10,8,2,.97);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease}
.mob-overlay.open{opacity:1;pointer-events:all}
.mob-nav{display:flex;flex-direction:column;align-items:center;width:100%;max-width:340px;animation:mobNavIn .3s ease forwards}
@keyframes mobNavIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
.mob-link{font-family:'Poppins',sans-serif;font-size:22px;font-weight:700;color:rgba(255,255,255,.85);text-decoration:none;padding:18px 0;width:100%;text-align:center;transition:color .2s ease}
.mob-link:hover{color:#DDA844}
.mob-divider{width:100%;height:1px;background:rgba(221,170,68,.15)}
.mob-close{position:absolute;top:24px;right:24px;background:none;border:none;font-size:32px;line-height:1;color:#DDA844;cursor:pointer;padding:8px;font-family:'Poppins',sans-serif}
@media(max-width:768px){
  .hd-hamburger{display:flex}
  .hd-nav{display:none}
  .hd-cta-btn{display:none}
}
</style>

<slot />

<script is:inline>
(function(){
  var hdr=document.getElementById('site-header');
  if(!hdr)return;
  function upd(){hdr.classList.toggle('scrolled',window.scrollY>10);}
  upd();
  window.addEventListener('scroll',upd,{passive:true});
})();
</script>

<footer>
  <div class="ft-in">
    <div class="ft-logo" style="font-family:'Great Vibes',cursive;font-size:clamp(24px,3vw,34px);font-weight:400;color:var(--gold);letter-spacing:.5px;line-height:1">Golden Magic Mirror</div>
    <div class="ft-links">
      <a href="/datenschutz">Datenschutz</a>
      <a href="/impressum">Impressum</a>
      <a href="/kontakt">Kontakt</a>
    </div>
    <div class="ft-copy">© 2026 Wittmann Eventbox</div>
  </div>
</footer>

<noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1746864376318084&ev=PageView&noscript=1"/></noscript>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.css">
<script is:inline src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.umd.js"></script>
<style is:inline>
  :root{
    --cc-bg:#1a1206; --cc-primary-color:#FAF6EF; --cc-secondary-color:rgba(255,255,255,.7);
    --cc-btn-primary-bg:#DDA844; --cc-btn-primary-color:#1a1206; --cc-btn-primary-hover-bg:#E9C462;
    --cc-btn-secondary-bg:rgba(255,255,255,.08); --cc-btn-secondary-color:#FAF6EF;
    --cc-btn-secondary-hover-bg:rgba(255,255,255,.15);
    --cc-toggle-on-bg:#DDA844; --cc-modal-box-shadow:0 8px 40px rgba(0,0,0,.5);
    --cc-border-radius:14px; --cc-btn-border-radius:10px;
  }
  #cc-main .cm__btn, #cc-main .pm__btn{font-family:'Mulish',sans-serif;font-weight:700}
  #cc-main .cm__title, #cc-main .pm__title{font-family:'Poppins',sans-serif}
</style>
<script is:inline>
  window.addEventListener('load', function(){
    if (typeof CookieConsent === 'undefined') return;

    function grant(){
      gtag('consent','update',{
        'ad_storage':'granted','ad_user_data':'granted',
        'ad_personalization':'granted','analytics_storage':'granted'
      });
      try{ localStorage.setItem('wb_consent', JSON.stringify({ad_storage:'granted'})); }catch(e){}
    }
    function deny(){
      gtag('consent','update',{
        'ad_storage':'denied','ad_user_data':'denied',
        'ad_personalization':'denied','analytics_storage':'denied'
      });
      try{ localStorage.removeItem('wb_consent'); }catch(e){}
    }
    function handle(){
      if (CookieConsent.acceptedCategory('marketing')) grant();
      else deny();
    }

    CookieConsent.run({
      guiOptions:{
        consentModal:{layout:'box',position:'bottom left'},
        preferencesModal:{layout:'box'}
      },
      categories:{
        necessary:{enabled:true, readOnly:true},
        marketing:{}
      },
      onFirstConsent:handle, onChange:handle,
      language:{
        default:'de',
        translations:{
          de:{
            consentModal:{
              title:'Wir verwenden Cookies',
              description:'Wir nutzen Cookies, um unsere Website zu verbessern und Marketing-Maßnahmen zu messen. Sie können frei entscheiden. Details in unserer <a href="/datenschutz">Datenschutzerklärung</a>.',
              acceptAllBtn:'Alle akzeptieren',
              acceptNecessaryBtn:'Nur notwendige',
              showPreferencesBtn:'Einstellungen'
            },
            preferencesModal:{
              title:'Cookie-Einstellungen',
              acceptAllBtn:'Alle akzeptieren',
              acceptNecessaryBtn:'Nur notwendige',
              savePreferencesBtn:'Auswahl speichern',
              sections:[
                {title:'Notwendig', description:'Für den Betrieb der Website erforderlich.', linkedCategory:'necessary'},
                {title:'Statistik & Marketing', description:'Hilft uns, die Website und unsere Anzeigen zu verbessern (Google Ads).', linkedCategory:'marketing'}
              ]
            }
          }
        }
      }
    });
  });
</script>

<script is:inline>
(function(){
  var wa=document.querySelector('.wa-float');
  if(!wa)return;
  // Hide above the fold (hero section), show when scrolled past it
  function updateScroll(){
    if(window.scrollY<window.innerHeight){wa.classList.add('hidden');}
    else{wa.classList.remove('hidden');}
  }
  updateScroll();
  window.addEventListener('scroll',updateScroll,{passive:true});
  // Hide when keyboard open on mobile
  document.addEventListener('focusin',function(e){
    if(window.innerWidth<=768&&(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.tagName==='SELECT')){
      wa.style.display='none';
    }
  });
  document.addEventListener('focusout',function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.tagName==='SELECT'){
      wa.style.display='';
    }
  });
})();
</script>

<a
  href="https://wa.me/436604313993"
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="WhatsApp Kontakt"
  onclick="if(typeof gtag!=='undefined'){gtag('event','whatsapp_click',{'event_category':'engagement','event_label':'floating_button'});}"
>
  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path fill="#fff" d="M16.001 5.333c-5.891 0-10.667 4.776-10.667 10.667 0 1.882.49 3.717 1.42 5.336L5.333 26.667l5.486-1.41a10.616 10.616 0 0 0 5.18 1.32h.004c5.89 0 10.666-4.776 10.666-10.667 0-2.851-1.111-5.531-3.128-7.548a10.604 10.604 0 0 0-7.54-3.119zm0 19.388h-.003a8.84 8.84 0 0 1-4.503-1.234l-.323-.192-3.347.86.892-3.262-.21-.336a8.834 8.834 0 0 1-1.355-4.72c0-4.886 3.977-8.863 8.866-8.863a8.806 8.806 0 0 1 6.265 2.598 8.804 8.804 0 0 1 2.598 6.27c0 4.887-3.977 8.863-8.88 8.879zm4.864-6.642c-.267-.133-1.578-.778-1.822-.867-.244-.089-.422-.133-.6.134-.178.266-.689.867-.844 1.045-.156.178-.311.2-.578.067-.267-.134-1.127-.415-2.148-1.324-.794-.708-1.33-1.583-1.486-1.85-.156-.267-.017-.41.117-.544.12-.119.267-.311.4-.467.134-.156.178-.267.267-.444.089-.178.044-.334-.022-.467-.067-.134-.6-1.446-.822-1.98-.217-.519-.437-.449-.6-.457l-.511-.009a.984.984 0 0 0-.711.334c-.244.267-.933.911-.933 2.222 0 1.311.955 2.578 1.088 2.756.134.178 1.882 2.872 4.555 4.028.637.275 1.134.439 1.522.561.639.203 1.222.175 1.682.106.513-.077 1.578-.645 1.8-1.267.223-.622.223-1.156.156-1.267-.067-.111-.244-.178-.511-.311z"/>
  </svg>
</a>

</body>
</html>
