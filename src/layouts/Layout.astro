<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vanilla-cookieconsent@3/dist/cookieconsent.css"/>
<script is:inline>
(function(){
  function updateConsent(){
    var analytics=CookieConsent.acceptedCategory('analytics');
    var marketing=CookieConsent.acceptedCategory('marketing');
    gtag('consent','update',{
      'ad_storage':marketing?'granted':'denied',
      'ad_user_data':marketing?'granted':'denied',
      'ad_personalization':marketing?'granted':'denied',
      'analytics_storage':analytics?'granted':'denied'
    });
    if(marketing)loadFbPixel();
  }
  function loadFbPixel(){
    if(window._fbLoaded)return;window._fbLoaded=true;
    if(window.fbq)return;
    var n=window.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments);};
    if(!window._fbq)window._fbq=n;
    n.push=n;n.loaded=true;n.version='2.0';n.queue=[];
    var s=document.createElement('script');s.async=true;
    s.src='https://connect.facebook.net/en_US/fbevents.js';
    document.head.appendChild(s);
    window.fbq('init','1746864376318084');
    window.fbq('track','PageView');
  }
  function initCC(){
    CookieConsent.run({
      guiOptions:{consentModal:{layout:'bar',position:'bottom center',equalWeightButtons:false,flipButtons:false}},
      categories:{necessary:{enabled:true,readOnly:true},analytics:{},marketing:{}},
      language:{
        default:'de',
        translations:{de:{
          consentModal:{
            title:'Diese Website verwendet Cookies',
            description:'Wir verwenden Cookies fuer Analyse und Marketing. Sie koennen Ihre Einwilligung jederzeit widerrufen.',
            acceptAllBtn:'Alle akzeptieren',
            acceptNecessaryBtn:'Ablehnen',
            showPreferencesBtn:'Auswahl',
            footer:'<a href="/datenschutz">Datenschutz</a> &middot; <a href="/impressum">Impressum</a>'
          },
          preferencesModal:{
            title:'Cookie Einstellungen',
            acceptAllBtn:'Alle akzeptieren',
            acceptNecessaryBtn:'Ablehnen',
            savePreferencesBtn:'Auswahl speichern',
            sections:[
              {title:'Notwendige Cookies',description:'Fuer den Betrieb der Website erforderlich.',linkedCategory:'necessary'},
              {title:'Statistiken',description:'Helfen uns zu verstehen wie Besucher die Website nutzen (Google Analytics).',linkedCategory:'analytics'},
              {title:'Marketing',description:'Werden verwendet um relevante Werbung anzuzeigen (Google Ads, Facebook).',linkedCategory:'marketing'}
            ]
          }
        }}
      },
      onConsent:updateConsent,
      onChange:updateConsent
    });
  }
  var s=document.createElement('script');
  s.src='https://cdn.jsdelivr.net/npm/vanilla-cookieconsent@3/dist/cookieconsent.umd.js';
  s.onload=initCC;
  document.head.appendChild(s);
})();
</script>
<style is:global>
