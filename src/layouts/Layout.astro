<style is:global>
.hd-hamburger{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:40px;height:40px;background:none;border:none;cursor:pointer;padding:0;flex-shrink:0}
.hd-hamburger span{display:block;width:24px;height:2px;background:#DDA844;border-radius:2px;transition:transform .25s ease,opacity .25s ease}
.mob-overlay{position:fixed;inset:0;z-index:9999;background:rgba(10,8,2,.97);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s ease}
.mob-overlay.open{opacity:1;pointer-events:all}
.mob-nav{display:flex;flex-direction:column;align-items:center;width:100%;max-width:340px;animation:mobNavIn .3s ease forwards}
@keyframes mobNavIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
.mob-link{font-family:'Poppins',sans-serif;font-size:22px;font-weight:700;color:rgba(255,255,255,.85);text-decoration:none;padding:18px 0;width:100%;text-align:center;transition:color .2s ease}
.mob-link:hover{color:#DDA844}
.mob-divider{width:100%;height:1px;background:rgba(221,170,68,.15)}
.mob-close{position:absolute;top:24px;right:24px;background:none;border:none;font-size:32px;line-height:1;color:#DDA844;cursor:pointer;padding:8px;font-family:'Poppins',sans-serif}
@media(max-width:768px){
  .hd-hamburger{display:flex}
  .hd-nav{display:none}
  .hd-cta-btn{display:none}
}
</style>

<slot />

<script is:inline>
(function(){
  var hdr=document.getElementById('site-header');
  if(!hdr)return;
  function upd(){hdr.classList.toggle('scrolled',window.scrollY>10);}
  upd();
  window.addEventListener('scroll',upd,{passive:true});
})();
(function(){
  var btn=document.getElementById('hdHamburger');
  var overlay=document.getElementById('mobOverlay');
  var closeBtn=document.getElementById('mobClose');
  if(!btn||!overlay)return;
  function open(){overlay.classList.add('open');document.body.style.overflow='hidden';}
  function close(){overlay.classList.remove('open');document.body.style.overflow='';}
  btn.addEventListener('click',open);
  if(closeBtn)closeBtn.addEventListener('click',close);
  overlay.querySelectorAll('.mob-link').forEach(function(a){
    a.addEventListener('click',function(){
      close();
      var href=a.getAttribute('href');
      if(href&&href.startsWith('#')){
        var target=document.querySelector(href);
        if(target){setTimeout(function(){target.scrollIntoView({behavior:'smooth'});},10);}
      }
    });
  });
  overlay.addEventListener('click',function(e){if(e.target===overlay)close();});
})();
</script>

