---
import Layout from '../layouts/Layout.astro';
const today = new Date().toISOString().split('T')[0];
---
<Layout
  title="Kontakt – Wittmann Eventbox"
  description="Kontaktieren Sie Wittmann Eventbox für Ihre Golden Magic Mirror Fotobox Buchung in Wien. Unverbindliche Anfrage in wenigen Sekunden."
>

<style>
/* Pricing sidebar accordion – dark panel on white page */
.pac-wrap{margin-bottom:20px;border-radius:16px;border:1.5px solid rgba(221,170,68,.35);overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,.13),0 0 0 1px rgba(221,170,68,.08)}
.pac-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;background:linear-gradient(135deg,#1e1508,#2e1f06);border:none;border-radius:0;padding:16px 20px;cursor:pointer;color:#fff;text-align:left;transition:background .2s}
.pac-toggle:hover{background:linear-gradient(135deg,#2a1d09,#3a2608)}
.pac-toggle-left{display:flex;align-items:center;gap:10px}
.pac-icon{font-size:14px;color:var(--gold);flex-shrink:0}
.pac-title{font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;color:#fff}
.pac-arrow{color:var(--gold);flex-shrink:0;transition:transform .35s cubic-bezier(.22,1,.36,1)}
.pac-body{max-height:0;overflow:hidden;transition:max-height .55s cubic-bezier(.22,1,.36,1);background:linear-gradient(to bottom,#1a1208,#0f0c06)}
.pac-inner{padding:14px 16px 16px;display:flex;flex-direction:column;gap:10px}
/* Package cards */
.pac-pkg{border-radius:12px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.04);padding:14px 16px}
.pac-pkg-featured{border:1.5px solid rgba(221,170,68,.45);background:linear-gradient(135deg,rgba(221,170,68,.12),rgba(221,170,68,.06))}
.pac-pkg-deluxe{border:1.5px solid rgba(232,212,150,.3);background:linear-gradient(135deg,rgba(232,212,150,.09),rgba(221,170,68,.04))}
.pac-pkg-badge{font-size:10px;font-weight:700;color:var(--gold);letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
.pac-pkg-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:10px}
.pac-pkg-name{font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;color:rgba(255,255,255,.88)}
.pac-pkg-price{font-family:'Poppins',sans-serif;font-weight:800;font-size:20px;color:var(--gold)}
.pac-pkg-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:5px}
.pac-pkg-list li{font-size:12px;color:rgba(255,255,255,.65);display:flex;align-items:flex-start;gap:6px;line-height:1.45}
.pac-pkg-list li::before{content:'✓';color:#4ade80;font-weight:700;flex-shrink:0;margin-top:1px}
.pac-pkg-list li.no::before{content:'✗';color:rgba(255,255,255,.2)}
.pac-pkg-list li.no{color:rgba(255,255,255,.25)}
.pac-kaution-note{font-size:11px;color:rgba(255,255,255,.4);text-align:center;padding:10px 0 4px;border-top:1px solid rgba(221,170,68,.12);margin-top:4px}
.pac-kaution-note strong{color:rgba(255,255,255,.7)}
</style>

<div class="page-hero">
  <div class="wrap">
    <span class="tag">Unverbindliche Anfrage</span>
    <h1>Ihr Event, unser Highlight</h1>
    <p>Füllen Sie das Formular aus – wir melden uns innerhalb von 24 Stunden bei Ihnen.</p>
  </div>
</div>

<section class="form-section">
  <div class="wrap">
    <div class="form-grid">

      <!-- FORM -->
      <div class="form-card">
        <h2>Jetzt anfragen</h2>
        <p class="sub">Antwort innerhalb von 24h. Persönlich, kein Autoresponder.</p>
        <form id="contactForm" action="https://formspree.io/f/xbdqvrgy" method="POST">
          <div class="field">
            <label>Gewünschte Produkte * <span style="font-weight:400;font-size:12px;color:#aaa">(Mehrfachauswahl möglich)</span></label>
            <div style="display:flex;flex-direction:column;gap:10px;margin-top:4px">
              <label style="display:flex;align-items:center;gap:12px;padding:14px 16px;border:1.5px solid #e8e8e8;border-radius:10px;cursor:pointer;transition:border-color .2s" id="optMirror">
                <input type="checkbox" name="produkte" value="Golden Magic Mirror (500€)" checked style="width:auto;margin:0"/>
                <span style="font-size:14px;color:var(--dark)"><strong>Golden Magic Mirror</strong> – 500€</span>
              </label>
              <label style="display:flex;align-items:center;gap:12px;padding:14px 16px;border:1.5px solid #e8e8e8;border-radius:10px;cursor:pointer;transition:border-color .2s" id="optSeifenblasen">
                <input type="checkbox" name="produkte" value="Seifenblasenmaschine (+120€)" style="width:auto;margin:0"/>
                <span style="font-size:14px;color:var(--dark)"><strong>+ Seifenblasenmaschine</strong> – 120€</span>
              </label>
              <label style="display:flex;align-items:center;gap:12px;padding:14px 16px;border:1.5px solid #e8e8e8;border-radius:10px;cursor:pointer;transition:border-color .2s" id="optLove">
                <input type="checkbox" name="produkte" value="LOVE-Schild" id="checkLove" style="width:auto;margin:0"/>
                <span style="font-size:14px;color:var(--dark)"><strong>+ LOVE-Schild</strong> – ab 300€</span>
              </label>
              <div id="loveOptions" style="display:none;flex-direction:column;gap:8px;margin-left:16px;padding:12px 14px;background:#fafafa;border:1px solid #e8e8e8;border-radius:8px">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;color:var(--dark)">
                  <input type="radio" name="love_option" value="Lieferung &amp; Aufbau (+380€)" checked style="width:auto;margin:0"/>
                  Lieferung &amp; Aufbau (+380€)
                </label>
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:14px;color:var(--dark)">
                  <input type="radio" name="love_option" value="Selbstabholung (300€)" style="width:auto;margin:0"/>
                  Selbstabholung (300€)
                </label>
              </div>
            </div>
          </div>
          <div class="field">
            <label>Ihr Name *</label>
            <input type="text" name="vorname" placeholder="Max Mustermann" required autocomplete="name" autocapitalize="words"/>
          </div>
          <div class="field">
            <label>E-Mail-Adresse *</label>
            <input type="email" name="email" placeholder="max@beispiel.at" required autocomplete="email" autocapitalize="off" inputmode="email"/>
          </div>
          <div class="field">
            <label>Telefonnummer *</label>
            <input type="tel" name="telefon" placeholder="+43 660 ..." required autocomplete="tel" inputmode="tel"/>
          </div>
          <div class="field">
            <label>Event-Datum</label>
            <input type="date" name="datum" autocomplete="off" min={today}/>
            <small style="display:block;margin-top:6px;font-size:12px;color:#888">Schon ein Datum im Kopf? Hilft uns für die schnelle Verfügbarkeits-Antwort. Falls noch unsicher: einfach leer lassen.</small>
          </div>
          <div class="field">
            <label>Ihre Nachricht <span style="font-weight:400;color:#aaa;font-size:12px">(optional)</span></label>
            <textarea name="nachricht" placeholder="Weitere Wünsche, Fragen oder besondere Anforderungen ..."></textarea>
          </div>
          <button type="submit" class="submit-btn">Unverbindlich anfragen →</button>
          <p class="privacy-note">Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" style="color:var(--gold)">Datenschutzerklärung</a> zu.</p>
        </form>
        <div class="success-msg" id="successMsg">
          <strong>✓ Vielen Dank für Ihre Anfrage!</strong><br/>
          <span style="font-size:13px;color:#555">Wir melden uns innerhalb von 24 Stunden bei Ihnen.</span>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="contact-info">

        <!-- PRICING ACCORDION -->
        <div class="pac-wrap">
          <button class="pac-toggle" id="pacToggle" aria-expanded="false" onclick="togglePac()">
            <div class="pac-toggle-left">
              <span class="pac-icon">✦</span>
              <span class="pac-title">Unsere Preise</span>
            </div>
            <div class="pac-arrow" id="pacArrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </button>
          <div class="pac-body" id="pacBody">
            <div class="pac-inner">

              <div class="pac-pkg pac-pkg-featured">
                <div class="pac-pkg-header">
                  <span class="pac-pkg-name" style="color:var(--gold)">Golden Magic Mirror</span>
                  <span class="pac-pkg-price">€500</span>
                </div>
                <ul class="pac-pkg-list">
                  <li>Anfahrt inklusive</li>
                  <li>400 Sofortdrucke</li>
                  <li>Roter Teppich & goldene Stangen</li>
                  <li>Party-Equipment (Brillen, Hüte, Masken)</li>
                  <li>Profi LED-Ringlicht</li>
                  <li>Persönliche Betreuung vor Ort</li>
                  <li>Auf- & Abbau inklusive</li>
                </ul>
              </div>

              <div class="pac-pkg" style="border:1.5px solid rgba(229,186,88,.35)">
                <div class="pac-pkg-header">
                  <span class="pac-pkg-name">+ Seifenblasenmaschine</span>
                  <span class="pac-pkg-price">+120€</span>
                </div>
                <ul class="pac-pkg-list">
                  <li>RGB-LED, bis zu 10 Meter hoch</li>
                  <li>Intensität einstellbar</li>
                </ul>
              </div>

              <div class="pac-pkg" style="border:1.5px solid rgba(229,186,88,.35)">
                <div class="pac-pkg-header">
                  <span class="pac-pkg-name">+ LOVE-Schild</span>
                  <span class="pac-pkg-price">380€</span>
                </div>
                <ul class="pac-pkg-list">
                  <li>5 Buchstaben, je 1,20 m hoch</li>
                  <li>inkl. Lieferung &amp; Aufbau (Wien + 45 km)</li>
                  <li>oder 300€ Selbstabholung</li>
                </ul>
              </div>

              <div class="pac-pkg pac-pkg-featured" style="border:1.5px solid rgba(229,186,88,.6)">
                <div class="pac-pkg-badge">Premium Komplett · Spar-Paket</div>
                <div class="pac-pkg-header">
                  <span class="pac-pkg-name" style="color:var(--gold)">Premium Komplett-Paket</span>
                  <span class="pac-pkg-price">850€</span>
                </div>
                <p style="font-size:11px;color:rgba(255,255,255,.45);margin:0 0 8px;display:flex;align-items:center;gap:6px">
                  <span style="text-decoration:line-through;color:rgba(255,255,255,.3)">statt 1.000€</span>
                  <span style="color:#4ade80;font-weight:700">Sie sparen 150€</span>
                </p>
                <ul class="pac-pkg-list">
                  <li>Magic Mirror</li>
                  <li>Seifenblasenmaschine</li>
                  <li>LOVE-Schild inkl. Lieferung &amp; Aufbau</li>
                </ul>
              </div>

              <p class="pac-kaution-note">Kaution: <strong>€150</strong> – wird nach dem Event vollständig zurückerstattet.</p>
            </div>
          </div>
        </div>

        <!-- CONTACT INFO (original) -->
        <h3>Direkt Kontakt aufnehmen</h3>
        <div class="ci-item">
          <div class="ci-ic"><svg viewBox="0 0 24 24" fill="none"><path d="M22 16.92V19.92C22 20.48 21.74 21 21.29 21.34C20.84 21.68 20.26 21.79 19.72 21.65C16.56 20.83 13.55 19.24 11.01 17.01C8.65 14.96 6.78 12.43 5.64 9.59C5.04 8.08 4.97 6.41 5.45 4.86C5.62 4.33 6.02 3.88 6.54 3.62L9.09 2.41C9.59 2.17 10.17 2.24 10.6 2.59L12.73 4.29C13.16 4.64 13.31 5.22 13.1 5.73L12.17 8.01C12 8.41 12.08 8.87 12.38 9.19L14.81 11.62C15.13 11.92 15.59 12 15.99 11.83L18.27 10.9C18.78 10.69 19.36 10.84 19.71 11.27L21.41 13.4C21.76 13.83 21.83 14.41 21.59 14.91L22 16.92Z" stroke="var(--gold)" stroke-width="2" stroke-linecap="round"/></svg></div>
          <div class="ci-text"><strong>Telefon</strong><span><a href="tel:+436604313993">0660 431 39 93</a></span></div>
        </div>
        <div class="ci-item">
          <div class="ci-ic"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="var(--gold)" stroke-width="2" stroke-linecap="round"/><path d="M22 6L12 13L2 6" stroke="var(--gold)" stroke-width="2" stroke-linecap="round"/></svg></div>
          <div class="ci-text"><strong>E-Mail</strong><span><a href="mailto:wb@wittmann-eventbox.at">wb@wittmann-eventbox.at</a></span></div>
        </div>
        <div class="ci-item">
          <div class="ci-ic"><svg viewBox="0 0 24 24" fill="none"><path d="M21 10C21 17 12 23 12 23S3 17 3 10c0-5 4-9 9-9s9 4 9 9z" stroke="var(--gold)" stroke-width="2"/><circle cx="12" cy="10" r="3" stroke="var(--gold)" stroke-width="2"/></svg></div>
          <div class="ci-text"><strong>Einsatzgebiet</strong><span>Wien & Umgebung (Anfahrt inkl.)</span></div>
        </div>
        <div class="ci-item">
          <div class="ci-ic"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" stroke="var(--gold)" stroke-width="2"/><path d="M3 9H21M9 21V9" stroke="var(--gold)" stroke-width="2" stroke-linecap="round"/></svg></div>
          <div class="ci-text"><strong>Buchungszeitraum</strong><span>Mindestens 1 Woche im Voraus</span></div>
        </div>

        <div class="promise-box">
          <h4>Unsere Versprechen</h4>
          <div class="promise-item"><div class="promise-dot"></div>Antwort innerhalb von 24 Stunden</div>
          <div class="promise-item"><div class="promise-dot"></div>Völlig unverbindliche Anfrage</div>
          <div class="promise-item"><div class="promise-dot"></div>Auf- & Abbau inklusive</div>
          <div class="promise-item"><div class="promise-dot"></div>Keine versteckten Kosten</div>
        </div>

        <div class="ci-delivery">
          <h4>Preise & Lieferung</h4>
          <div class="ci-delivery-item">
            <span class="ci-delivery-icon">📍</span>
            <div>
              <strong>Wien & Umgebung</strong>
              <p>Stadtgebiet Wien + 50 km rund um Stockerau.</p>
            </div>
          </div>
          <div class="ci-delivery-item">
            <span class="ci-delivery-icon">✓</span>
            <div>
              <strong>Alles inklusive</strong>
              <p>Lieferung, Aufbau & Abholung im Preis enthalten.</p>
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
// Produkte aus sessionStorage vorauswählen
function showLoveOptions(show){
  const el=document.getElementById('loveOptions');
  if(el) el.style.display=show?'flex':'none';
}
document.getElementById('checkLove')?.addEventListener('change',function(){showLoveOptions(this.checked);});

const paket=sessionStorage.getItem('selectedPaket');
if(paket==='seifenblasen'){
  const cb=document.querySelector('input[name="produkte"][value*="Seifenblasen"]');
  if(cb) cb.checked=true;
}else if(paket==='love'){
  const cb=document.getElementById('checkLove');
  if(cb){cb.checked=true;showLoveOptions(true);}
}else if(paket==='komplett'){
  document.querySelectorAll('input[name="produkte"]').forEach(cb=>cb.checked=true);
  showLoveOptions(true);
}

// Preismodelle aufklappen
window.togglePac=function(){
  const body=document.getElementById('pacBody');
  const arrow=document.getElementById('pacArrow');
  const btn=document.getElementById('pacToggle');
  const open=btn.getAttribute('aria-expanded')==='true';
  if(open){body.style.maxHeight='0';arrow.style.transform='rotate(0deg)';btn.setAttribute('aria-expanded','false');}
  else{body.style.maxHeight=body.scrollHeight+'px';arrow.style.transform='rotate(180deg)';btn.setAttribute('aria-expanded','true');}
};

// Formular absenden
document.getElementById('contactForm').addEventListener('submit', async function(e){
  e.preventDefault();
  const btn = this.querySelector('.submit-btn');
  btn.textContent = 'Wird gesendet...';
  btn.disabled = true;
  try {
    // Merge multiple "produkte" checkboxes into one field for Formspree
    const raw = new FormData(this);
    const fd = new FormData();
    const produkte = [];
    const loveChecked = document.getElementById('checkLove')?.checked;
    for(const [key, val] of raw.entries()){
      if(key === 'produkte'){ produkte.push(val); }
      else if(key === 'love_option'){ if(loveChecked) fd.append(key, val); }
      else { fd.append(key, val); }
    }
    if(produkte.length) fd.append('produkte', produkte.join(', '));
    const res = await fetch(this.action, {
      method: 'POST',
      body: fd,
      headers: { 'Accept': 'application/json' }
    });
    if(res.ok){
      window.location.href = '/danke';
    } else {
      btn.textContent = 'Fehler – bitte erneut versuchen';
      btn.disabled = false;
    }
  } catch {
    btn.textContent = 'Fehler – bitte erneut versuchen';
    btn.disabled = false;
  }
});
</script>

</Layout>
