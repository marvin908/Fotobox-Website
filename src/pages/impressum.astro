  </div>
</div>

<section class="content-section">
  <div class="wrap">
    <div class="content-card">

      <h2>Unternehmensangaben</h2>
      <p><strong>Wittmann Eventbox</strong><br/>
      Inhaber: [Vorname Nachname]<br/>
      [Straße Hausnummer]<br/>
      [PLZ] Wien, Österreich</p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href="tel:+436604313993">+43 660 431 39 93</a><br/>
        E-Mail: <a href="mailto:wb@wittmann-eventbox.at">wb@wittmann-eventbox.at</a>
