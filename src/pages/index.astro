<script>
const numEl=document.getElementById('cdNum'),lblEl=document.getElementById('cdLbl'),flashEl=document.getElementById('flashEl'),choiceEl=document.getElementById('mirrorChoice'),cdEl=numEl&&numEl.parentElement;
const GV="'Great Vibes',cursive";
const seq=[
  {t:'3',l:'Lächeln!',s:'clamp(90px,14vw,170px)',lf:GV,ls:'clamp(28px,4.2vw,48px)',top:'40%'},
  {t:'2',l:'Lächeln!',s:'clamp(90px,14vw,170px)',lf:GV,ls:'clamp(28px,4.2vw,48px)',top:'40%'},
  {t:'1',l:'Lächeln!',s:'clamp(90px,14vw,170px)',lf:GV,ls:'clamp(28px,4.2vw,48px)',top:'40%'},
  {t:'🎉',l:'Bezaubernd!',s:'clamp(64px,9.5vw,116px)',lf:GV,ls:'clamp(34px,5.2vw,58px)',tw:true,top:'38%',fade:true},
  {t:'Signier mich!',l:'',s:'clamp(20px,3.8vw,46px)',tf:GV,rot:'-10deg',top:'52%',twnum:true},
  {t:'',l:'',s:'0px',choice:true}
];
const tim=[1500,1500,1500,2800,2500,2500];let si=0;let twId=null;
function typewrite(el,text,ms){if(twId)clearInterval(twId);el.textContent='';el.style.opacity='1';let i=0;twId=setInterval(()=>{el.textContent+=text[i];i++;if(i>=text.length){clearInterval(twId);twId=null;}},ms||55);}
function flash(){if(!flashEl)return;flashEl.style.transition='opacity .03s';flashEl.style.opacity='1';setTimeout(()=>{if(!flashEl)return;flashEl.style.transition='opacity .55s ease-out';flashEl.style.opacity='0';},120);}
function nextF(){if(twId){clearInterval(twId);twId=null;}if(choiceEl)choiceEl.classList.remove('show');si=(si+1)%seq.length;const s=seq[si];const cf=numEl.style.fontFamily||"'Poppins',sans-serif";const cfs=numEl.style.fontSize||seq[(si-1+seq.length)%seq.length].s||'inherit';const pr=seq[(si-1+seq.length)%seq.length].rot||'0deg';numEl.style.cssText=`font-family:${cf};font-size:${cfs};transition:transform .25s,opacity .25s;transform:scale(.5) rotate(${pr});opacity:0`;if(lblEl)lblEl.style.opacity='0';setTimeout(()=>{if(cdEl)cdEl.style.top=s.top||'50%';if(s.choice){numEl.textContent='';numEl.style.opacity='0';if(lblEl){lblEl.textContent='';lblEl.style.opacity='0';}if(choiceEl)choiceEl.classList.add('show');}else{if(lblEl){lblEl.style.fontFamily=s.lf||"'Poppins',sans-serif";lblEl.style.fontSize=s.ls||'13px';lblEl.style.letterSpacing=s.lf?'0.5px':'3px';lblEl.style.textTransform=s.lf?'none':'uppercase';if(s.tw&&s.l){lblEl.textContent='';lblEl.style.opacity='0';}else{lblEl.textContent=s.l;lblEl.style.opacity='1';}}if(s.twnum){numEl.textContent=s.t;numEl.style.cssText=`font-family:${s.tf||"'Great Vibes',cursive"};font-size:${s.s};white-space:nowrap;opacity:1;text-shadow:0 0 28px rgba(221,170,68,.55),0 2px 12px rgba(0,0,0,.3);animation:signReveal 2.4s cubic-bezier(0.22,0.61,0.36,1) forwards;`;}else if(s.fade){numEl.textContent=s.t;numEl.style.cssText=`font-family:${s.tf||"'Poppins',sans-serif"};font-size:${s.s};transition:opacity .9s ease,transform .9s ease;transform:scale(.85);opacity:0`;setTimeout(()=>{numEl.style.opacity='1';numEl.style.transform='scale(1)';},550);}else{numEl.textContent=s.t;numEl.style.cssText=`font-family:${s.tf||"'Poppins',sans-serif"};font-size:${s.s};transition:transform .4s cubic-bezier(.22,1,.36,1),opacity .4s;transform:scale(1) rotate(${s.rot||'0deg'});opacity:1`;}if(si===3){flash();if(s.tw&&s.l&&lblEl)setTimeout(()=>typewrite(lblEl,s.l,42),700);}else if(s.tw&&s.l&&lblEl)setTimeout(()=>typewrite(lblEl,s.l,42),700);}},220);}
let schedId=null;let heroPaused=false;
function sched(){if(heroPaused||schedId!==null)return;schedId=setTimeout(()=>{schedId=null;nextF();sched();},tim[si]||2000);}
// Apply initial label styles to match seq[0]
if(lblEl){const s0=seq[0];lblEl.style.fontFamily=s0.lf||"'Poppins',sans-serif";lblEl.style.fontSize=s0.ls||'12px';lblEl.style.letterSpacing=s0.lf?'0.5px':'3px';lblEl.style.textTransform=s0.lf?'none':'uppercase';}
sched();
const heroObserver=new IntersectionObserver(([e])=>{if(e.isIntersecting){heroPaused=false;sched();}else{heroPaused=true;clearTimeout(schedId);schedId=null;}},{threshold:0.1});
const heroEl=document.getElementById('hero');if(heroEl)heroObserver.observe(heroEl);
window.addEventListener('beforeunload',()=>{clearTimeout(schedId);heroObserver.disconnect();});
const months=['Jänner','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
const d=new Date();d.setMonth(d.getMonth()+1);
const nextMonthEl=document.getElementById('nextMonth');if(nextMonthEl)nextMonthEl.textContent=months[d.getMonth()];
function makeStars(id,count){const el=document.getElementById(id);if(!el)return;for(let i=0;i<count;i++){const s=document.createElement('div');s.className='mg-star';const big=Math.random()>.72;const sz=big?5+Math.random()*10:1.5+Math.random()*3.5;const tx=(Math.random()-.5)*500;const ty=(Math.random()-.5)*400;const md=20+Math.random()*30;const mdl=-(Math.random()*22);s.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;--d:${big?6+Math.random()*8:3+Math.random()*5}s;--dl:${Math.random()*12}s;--tx:${tx}px;--ty:${ty}px;--md:${md}s;--mdl:${mdl}s${big?';filter:blur(2.5px)':''}`;el.appendChild(s);}}
const isMob=window.innerWidth<768;
makeStars('heroStars',isMob?25:55);makeStars('evStars',isMob?20:55);
function makeMirrorBokeh(id,count){const el=document.getElementById(id);if(!el)return;for(let i=0;i<count;i++){const b=document.createElement('div');b.className='mbk';const big=Math.random()>.72;const sz=big?3.5+Math.random()*5:1+Math.random()*2.5;const tx=(Math.random()-.5)*30;const ty=(Math.random()-.5)*30;b.style.cssText=`left:${8+Math.random()*84}%;top:${8+Math.random()*84}%;width:${sz}px;height:${sz}px;background:rgba(221,170,68,${big?.85:.7});box-shadow:0 0 ${sz*2.5}px ${sz*1.2}px rgba(221,170,68,.2);--d:${5+Math.random()*8}s;--dl:-${Math.random()*8}s;--p:${3+Math.random()*4}s;--pl:-${Math.random()*4}s;--tx:${tx}px;--ty:${ty}px;--oa:${.08+Math.random()*.12};--ob:${.28+Math.random()*.28}`;el.appendChild(b);}}
makeMirrorBokeh('mirrorBokeh',isMob?5:9);
function makeFireflies(id,count){const el=document.getElementById(id);if(!el)return;for(let i=0;i<count;i++){const f=document.createElement('div');f.className='firefly';const sz=2+Math.random()*4;const glow=5+Math.random()*10;const tx=(Math.random()-.5)*320;const ty=(Math.random()-.5)*320;const md=14+Math.random()*20;const mdl=-(Math.random()*20);f.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;width:${sz}px;height:${sz}px;background:rgba(221,170,68,.95);box-shadow:0 0 ${glow}px ${glow*.5}px rgba(221,170,68,.35);--d:${4+Math.random()*7}s;--dl:${Math.random()*12}s;--tx:${tx}px;--ty:${ty}px;--md:${md}s;--mdl:${mdl}s`;el.appendChild(f);}}
makeFireflies('evFireflyBg',isMob?12:30);makeFireflies('fireflyBg',isMob?12:30);
window.toggleFaq=function(btn){const body=btn.nextElementSibling;const isOpen=body.classList.contains('open');document.querySelectorAll('.faq-body').forEach(b=>b.classList.remove('open'));document.querySelectorAll('.faq-toggle').forEach(b=>b.classList.remove('open'));if(!isOpen){body.classList.add('open');btn.classList.add('open');}}
const obs=new IntersectionObserver((entries)=>{entries.forEach(x=>{if(x.isIntersecting){x.target.classList.add('visible');x.target.classList.remove('exiting');}else if(x.boundingClientRect.top<0){x.target.classList.add('exiting');x.target.classList.remove('visible');}else{x.target.classList.remove('visible','exiting');}});},{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.reveal-scale').forEach(el=>obs.observe(el));
document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(a){const t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}}});
window.goContact=function(paket){sessionStorage.setItem('selectedPaket',paket||'');window.location.href='/kontakt';};
let demoSi:number=0,demoCdTimer:ReturnType<typeof setInterval>|null=null,demoAutoTimer:ReturnType<typeof setTimeout>|null=null;
const _w=window as any;
_w.demoGoto=function(i:number){
  if(demoAutoTimer){clearTimeout(demoAutoTimer);demoAutoTimer=null;}
  if(demoCdTimer){clearInterval(demoCdTimer);demoCdTimer=null;}
  const screens=document.querySelectorAll('.demo-screen');
  const dots=document.querySelectorAll('.demo-dot');
  const steps=document.querySelectorAll('.demo-step-item');
  if(screens[demoSi])screens[demoSi].classList.remove('ds-active');
  if(dots[demoSi])dots[demoSi].classList.remove('active');
  if(steps[demoSi])steps[demoSi].classList.remove('active');
  demoSi=((i%6)+6)%6;
  if(screens[demoSi])screens[demoSi].classList.add('ds-active');
  if(dots[demoSi])dots[demoSi].classList.add('active');
  if(steps[demoSi])steps[demoSi].classList.add('active');
  if(demoSi===1)startDemoCd();
  else if(demoSi===3){demoAutoTimer=setTimeout(()=>_w.demoGoto(4),2200);}
  else if(demoSi===4)startDemoSign();
};
_w.demoNext=function(){_w.demoGoto(demoSi+1);};
_w.demoPrev=function(){_w.demoGoto(demoSi-1);};
function startDemoCd(){
  const el=document.getElementById('demoCdNum');
  const flash=document.getElementById('demoFlash') as HTMLElement|null;
  if(!el)return;
  let n:number=3;el.textContent=String(n);el.style.opacity='1';el.style.transform='scale(1)';
  demoCdTimer=setInterval(()=>{
    n--;
    if(n>0){
      el.style.opacity='0';el.style.transform='scale(1.3)';
      setTimeout(()=>{el.textContent=String(n);el.style.opacity='1';el.style.transform='scale(1)';},180);
    } else {
      clearInterval(demoCdTimer!);demoCdTimer=null;
      el.style.opacity='0';
      if(flash){flash.style.transition='opacity .05s';flash.style.opacity='1';setTimeout(()=>{flash.style.transition='opacity .5s ease-out';flash.style.opacity='0';},150);}
      setTimeout(()=>_w.demoGoto(2),700);
    }
  },900);
}
function startDemoSign(){
  const el=document.getElementById('demoSignText');
  if(!el)return;
  el.textContent='';
  const text='Martina ♡';let i=0;
  const t=setInterval(()=>{if(i<text.length){el.textContent+=text[i];i++;}else clearInterval(t);},90);
}
(function(){
  const dev=document.querySelector('.demo-device');
  if(!dev)return;
  let sx=0,sy=0;
  dev.addEventListener('touchstart',(e)=>{const te=e as TouchEvent;sx=te.changedTouches[0].clientX;sy=te.changedTouches[0].clientY;},{passive:true});
  dev.addEventListener('touchend',(e)=>{
    const te=e as TouchEvent;
    const dx=te.changedTouches[0].clientX-sx;
    const dy=te.changedTouches[0].clientY-sy;
    if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>40){if(dx<0)_w.demoNext();else _w.demoPrev();}
  });
})();
(function(){
  const bar=document.getElementById('trustBar');
  if(!bar)return;
  function update(){
    const items=bar.querySelectorAll('.ti');
    const rect=bar.getBoundingClientRect();
    const cx=rect.left+rect.width/2;
    items.forEach(item=>{
      const ir=item.getBoundingClientRect();
      const icx=ir.left+ir.width/2;
      const dist=Math.abs(cx-icx);
      const max=rect.width/2;
      const norm=Math.min(dist/max,1);
      item.style.opacity=(1-norm*0.82).toString();
    });
    requestAnimationFrame(update);
  }
  requestAnimationFrame(update);
})();
// Direct anchor URL handling (z.B. von Google Ads kommend)
window.addEventListener('load', () => {
  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    }
  }
});
</script>

