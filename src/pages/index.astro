---
import Layout from '../layouts/Layout.astro';
import GalleryStack from '../components/GalleryStack.tsx';
---
<Layout
  title="Golden Magic Mirror Fotobox Wien – Wittmann Eventbox"
  description="Die Golden Magic Mirror Fotobox für Hochzeiten, Geburtstage & Firmenfeiern in Wien. Sofortdrucke, persönliche Betreuung & Aufbau inklusive. Jetzt unverbindlich anfragen!"
  isHome={true}
>

<!-- HERO -->
<section id="hero">
  <div class="mg-stars-bg" id="heroStars"></div>
  <div class="hero-inner">
    <div class="hero-text">
      <span class="tag hfi hfi-1" style="background:none;border:none;border-radius:0;padding:0;display:inline">Hochzeiten · Geburtstage · Firmenfeiern</span>
      <h1 class="hfi hfi-2">Golden Magic Mirror<br/><span style="color:#E9C462">Spiegelfotobox</span> mieten in Wien & Umgebung.</h1>
      <p class="hero-sub hfi hfi-3" style="font-size:clamp(13px,1.5vw,16px);color:rgba(255,255,255,0.68);line-height:1.65;margin:16px 0 0;max-width:480px">
        Inkl. Aufbau, rotem Teppich, Goldstangen, 400 Sofortdrucken und Betreuung vor Ort. <span style="color:var(--gold);font-weight:600">Alles in einem Paket.</span>
      </p>
<div class="hero-cta-row hfi hfi-4" style="margin-top:clamp(24px,3.5vw,40px)">
        <a href="#pricing" class="btn-hero-glass hfi hfi-4" style="background:#E5BA58;color:#1a1000;border:none;box-shadow:0 4px 20px rgba(229,186,88,.35)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="#1a1000"/></svg>
          Jetzt Wunschtermin sichern
        </a>
        <a href="#galerie" class="btn-hero-secondary hfi hfi-4">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7 7 7-7" stroke="rgba(255,255,255,.85)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  Galerie ansehen
</a>
      </div>
      <div class="hero-trust-row hfi hfi-5">
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>500€ alles inklusive</span>
        </div>
        <div class="hero-trust-sep">·</div>
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Antwort in max. 24h</span>
        </div>
        <div class="hero-trust-sep">·</div>
        <div class="hero-trust-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Unverbindlich</span>
        </div>
      </div>
    </div>
    <div class="hero-visual hfi hfi-6">
      <div class="mirror-wrap">
      <div class="mirror-ornament">
        <svg width="48" height="36" viewBox="0 0 48 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="24" y1="36" x2="24" y2="22" stroke="url(#og)" stroke-width="1"/>
          <circle cx="24" cy="19" r="2.5" fill="#DDA844" opacity=".9"/>
          <path d="M24 14 L28 8 L24 2 L20 8 Z" fill="url(#od)" opacity=".95"/>
          <path d="M12 12 L18 9 L20 3 L14 6 Z" fill="url(#od)" opacity=".7"/>
          <path d="M36 12 L30 9 L28 3 L34 6 Z" fill="url(#od)" opacity=".7"/>
          <circle cx="11" cy="13" r="1.8" fill="#E8D496" opacity=".8"/>
          <circle cx="37" cy="13" r="1.8" fill="#E8D496" opacity=".8"/>
          <defs>
            <linearGradient id="og" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#DDA844" stop-opacity="0"/>
              <stop offset="100%" stop-color="#DDA844" stop-opacity=".7"/>
            </linearGradient>
            <linearGradient id="od" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#f8e8a0"/>
              <stop offset="100%" stop-color="#b07828"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="mirror-frame">
        <div class="mirror-screen">
          <div class="mirror-bokeh" id="mirrorBokeh"></div>
          <div class="mirror-bg">
            <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,rgba(255,255,255,.07) 0%,transparent 45%)"></div>
            <div style="position:absolute;top:12px;left:50%;transform:translateX(-50%);display:flex;gap:7px">
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.2)"></div>
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(221,170,68,.5)"></div>
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.2)"></div>
            </div>
          </div>
        </div>
        <div style="position:absolute;top:6%;left:12%;width:18%;height:40%;background:linear-gradient(170deg,rgba(255,255,255,.45),rgba(255,255,255,.0));border-radius:50%;pointer-events:none;transform:rotate(-15deg);filter:blur(6px)"></div>
        <div style="position:absolute;top:4%;right:18%;width:6%;height:18%;background:linear-gradient(170deg,rgba(255,255,255,.3),transparent);border-radius:50%;pointer-events:none;filter:blur(4px)"></div>
        <div class="flash-overlay" id="flashEl"></div>
        <div class="mirror-cd">
          <div class="cd-num" id="cdNum">3</div>
          <div class="cd-lbl" id="cdLbl">Lächeln!</div>
        </div>
        <div class="mirror-choice" id="mirrorChoice">
          <p class="mc-title">Ihr Foto ist bereit</p>
          <div class="mc-btns">
            <div class="mc-btn">
              <div class="mc-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="2" width="14" height="20" rx="3" stroke="#B07828" stroke-width="1.8"/><circle cx="12" cy="17" r="1.2" fill="#B07828"/><path d="M9 7h6" stroke="#B07828" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div class="mc-lbl">QR-Code</div>
              <div class="mc-sub">Digital teilen</div>
            </div>
            <div class="mc-btn mc-btn-active">
              <div class="mc-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="18" height="11" rx="2" stroke="#B07828" stroke-width="1.8"/><path d="M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" stroke="#B07828" stroke-width="1.8"/><rect x="8" y="12" width="8" height="3" rx="1" stroke="#B07828" stroke-width="1.5"/></svg>
              </div>
              <div class="mc-lbl">Sofortdruck</div>
              <div class="mc-sub">Foto mitnehmen</div>
            </div>
          </div>
        </div>
        <div class="mirror-dots"><div class="mirror-dot on"></div><div class="mirror-dot"></div><div class="mirror-dot"></div></div>
      </div>
      </div><!-- /mirror-wrap -->
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar" id="trustBar">
  <div class="tb-vignette-l"></div>
  <div class="tb-vignette-r"></div>
  <div class="marquee">
    <div class="ti">Gäste lachen ab der ersten Sekunde</div><div class="ti-sep">✦</div>
    <div class="ti">Jeder nimmt ein Foto mit nach Hause</div><div class="ti-sep">✦</div>
    <div class="ti">Null Aufwand für Sie</div><div class="ti-sep">✦</div>
    <div class="ti">Funktioniert bei jeder Altersgruppe</div><div class="ti-sep">✦</div>
    <div class="ti">Aufbau & Abbau inklusive</div><div class="ti-sep">✦</div>
    <div class="ti">Wien & Umgebung</div><div class="ti-sep">✦</div>
    <div class="ti">Persönliche Betreuung vor Ort</div><div class="ti-sep">✦</div>
    <div class="ti">Gäste lachen ab der ersten Sekunde</div><div class="ti-sep">✦</div>
    <div class="ti">Jeder nimmt ein Foto mit nach Hause</div><div class="ti-sep">✦</div>
    <div class="ti">Null Aufwand für Sie</div><div class="ti-sep">✦</div>
    <div class="ti">Funktioniert bei jeder Altersgruppe</div><div class="ti-sep">✦</div>
    <div class="ti">Aufbau & Abbau inklusive</div><div class="ti-sep">✦</div>
    <div class="ti">Wien & Umgebung</div><div class="ti-sep">✦</div>
    <div class="ti">Persönliche Betreuung vor Ort</div><div class="ti-sep">✦</div>
  </div>
</div>


<!-- GALLERY -->
<section id="galerie" style="padding:var(--section-y) 0;background:linear-gradient(to bottom,#110D04 0%,#0f0d08 20%,#0f0d08 80%,#1E1508 100%);position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 70% 50% at 50% 55%,rgba(221,170,68,.09),transparent 70%);pointer-events:none"></div>
  <div class="wrap" style="position:relative;z-index:1;text-align:center;margin-bottom:clamp(16px,3vw,32px)">
    <div class="reveal">
      <span class="tag">Galerie</span>
      <h2 class="sec-title" style="margin:14px 0 12px;color:var(--white)">So sieht der Magic Mirror aus,<br/>wenn er Ihr Event verwandelt.</h2>
      <p class="sec-sub" style="margin:0 auto;color:rgba(255,255,255,.6)">Das Gerät spricht für sich – Ihre Gäste schreiben die Geschichte.</p>
    </div>
  </div>
  <GalleryStack client:visible />

  <div class="polaroid-row reveal" style="display:flex;align-items:flex-end;justify-content:center;gap:clamp(16px,3vw,40px);margin-top:clamp(48px,6vw,80px);padding:0 clamp(20px,4vw,48px);flex-wrap:wrap">

    <div style="transform:rotate(-3.5deg);transition:transform .3s ease" onmouseover="this.style.transform='rotate(0deg) scale(1.04)'" onmouseout="this.style.transform='rotate(-3.5deg)'">
      <div style="background:#fff;padding:12px;box-shadow:0 12px 48px rgba(0,0,0,.55),0 2px 8px rgba(0,0,0,.35);border-radius:2px;width:clamp(180px,20vw,240px)">
        <img src="/gallery/Gaeste-Fotobox-13.jpg" alt="Gäste an der Magic Mirror Fotobox" style="width:100%;aspect-ratio:4/5;object-fit:cover;display:block"/>
      </div>
    </div>

    <div style="transform:rotate(1.5deg);transition:transform .3s ease" onmouseover="this.style.transform='rotate(0deg) scale(1.04)'" onmouseout="this.style.transform='rotate(1.5deg)'">
      <div style="background:#fff;padding:12px;box-shadow:0 12px 48px rgba(0,0,0,.55),0 2px 8px rgba(0,0,0,.35);border-radius:2px;width:clamp(180px,20vw,240px)">
        <img src="/gallery/Fotobox-Personen-10.jpg" alt="Echte Momente an der Spiegelfotobox" style="width:100%;aspect-ratio:4/5;object-fit:cover;display:block"/>
      </div>
    </div>

    <div style="transform:rotate(-2deg);transition:transform .3s ease" onmouseover="this.style.transform='rotate(0deg) scale(1.04)'" onmouseout="this.style.transform='rotate(-2deg)'">
      <div style="background:#fff;padding:12px;box-shadow:0 12px 48px rgba(0,0,0,.55),0 2px 8px rgba(0,0,0,.35);border-radius:2px;width:clamp(180px,20vw,240px)">
        <img src="/gallery/Fotobox-Event-5.jpg" alt="Stimmung beim Event mit Magic Mirror" style="width:100%;aspect-ratio:4/5;object-fit:cover;display:block"/>
      </div>
    </div>

  </div>

  <div class="reveal" style="text-align:center;margin-top:clamp(28px,4vw,48px);position:relative;z-index:1">
    <a href="/kontakt" style="display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border:1.5px solid rgba(221,170,68,.45);border-radius:50px;font-family:'Poppins',sans-serif;font-size:15px;font-weight:600;color:var(--gold);letter-spacing:.04em;text-decoration:none;transition:background .3s,border-color .3s,box-shadow .3s" onmouseover="this.style.background='rgba(221,170,68,.08)';this.style.borderColor='rgba(221,170,68,.75)';this.style.boxShadow='0 0 24px rgba(221,170,68,.15)'" onmouseout="this.style.background='';this.style.borderColor='rgba(221,170,68,.45)';this.style.boxShadow=''">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Jetzt anfragen
    </a>
  </div>
</section>
<div class="sec-div" style="background:linear-gradient(180deg,#1E1508,#FAF6EE)"><span class="sec-div-gem"><span class="sec-div-gem-inner"></span></span></div>
<!-- MAGIC (light bg) -->
<section id="magic" style="padding:var(--section-y) 0;background:#FAF6EE;position:relative;overflow:hidden">
  <div class="wrap">
    <div class="mg-hd reveal-scale">
      <span class="tag">Mieten & Erleben</span>
      <h2 class="sec-title" style="color:var(--dark)">So funktioniert<br/><em style="font-family:'Great Vibes',cursive;font-style:normal;font-weight:400;color:var(--gold-dark);font-size:1.7em;letter-spacing:.5px;display:inline-block;margin-top:10px">Die Magie des Spiegels</em></h2>
      <div class="mg-deco"><div class="mg-line" style="background:rgba(150,100,30,.3)"></div><div class="mg-stars-txt" style="color:var(--gold-dark)">✦ ✦ ✦</div><div class="mg-line r" style="background:rgba(150,100,30,.3)"></div></div>
      <p class="mg-sub" style="color:rgba(17,17,17,.82)">Klick dich durch den Ablauf – <span style="color:#8B5E14;font-style:italic;font-weight:600">die Layouts gestalten wir individuell für dich.</span></p>
    </div>

    <style is:global>
    .demo-outer{display:flex;align-items:center;justify-content:center;gap:clamp(12px,3vw,32px);margin-top:clamp(32px,4vw,48px)}
    .demo-frame{position:relative;padding:26px;background:linear-gradient(145deg,#FFE87C 0%,#DEB030 8%,#B07018 20%,#784208 34%,#542E04 44%,#86500E 56%,#BE7418 68%,#DEB030 80%,#FFE87C 90%,#BE7418 100%);border-radius:3px;box-shadow:inset 0 7px 16px rgba(255,240,130,0.55),inset 7px 0 10px rgba(255,240,130,0.26),inset 0 -7px 16px rgba(35,14,0,0.75),inset -7px 0 10px rgba(35,14,0,0.44),0 0 0 2px #2E1402,0 0 0 4px #B07018,0 0 0 6px #2E1402,0 38px 90px rgba(0,0,0,0.62);flex-shrink:0;align-self:center;width:clamp(250px,34vw,300px)}
    .demo-frame::before{content:'';position:absolute;inset:13px;border-radius:2px;border:5px dotted rgba(80,42,4,0.72);pointer-events:none;z-index:10}
    .demo-frame::after{content:'';position:absolute;inset:8px;border-top:1.5px solid rgba(255,238,140,0.42);border-left:1.5px solid rgba(255,238,140,0.22);border-bottom:1.5px solid rgba(25,10,0,0.55);border-right:1.5px solid rgba(25,10,0,0.32);border-radius:3px;pointer-events:none;z-index:10}
    .demo-device{position:relative;width:100%;aspect-ratio:9/16;background:#0a0806;border-radius:6px;overflow:hidden}
    .demo-screen{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .38s,transform .38s;transform:scale(.96)}
    .demo-screen.ds-active{opacity:1;pointer-events:auto;transform:scale(1)}
    .demo-ph-bg{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding:24px}
    .demo-ph-label-sm{font-size:11px;color:rgba(255,255,255,.38);font-family:'Poppins',sans-serif;text-align:center;line-height:1.6;letter-spacing:.03em}
    .demo-screen-footer{position:absolute;bottom:0;left:0;right:0;padding:14px 16px;display:flex;justify-content:center}
    .demo-screen-footer-row{gap:10px}
    .demo-action-btn{background:linear-gradient(135deg,#DDA844,#B07828);border:none;border-radius:50px;color:#1a1000;font-family:'Poppins',sans-serif;font-weight:700;font-size:13px;padding:10px 22px;cursor:pointer;letter-spacing:.03em;transition:opacity .2s,transform .15s;white-space:nowrap}
    .demo-action-btn:hover{opacity:.88;transform:scale(.97)}
    .demo-btn-sec{background:rgba(255,255,255,.1)!important;color:rgba(255,255,255,.75)!important;border:1px solid rgba(255,255,255,.15);font-weight:600!important}
    .demo-event-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;padding-bottom:60px}
    .demo-event-name{font-family:'Great Vibes',cursive;font-size:clamp(22px,4vw,30px);color:rgba(221,170,68,1);text-shadow:0 1px 16px rgba(0,0,0,.95),0 0 40px rgba(221,170,68,.3);letter-spacing:.5px;text-align:center}
    .demo-event-date{font-family:'Poppins',sans-serif;font-size:10px;color:rgba(255,255,255,.85);letter-spacing:.15em;text-transform:uppercase;text-align:center}
    .demo-event-hint{font-size:9px;color:rgba(221,170,68,.6);font-family:'Poppins',sans-serif;letter-spacing:.05em;margin-top:10px;text-align:center;padding:0 20px;line-height:1.5}
    .demo-cd-num{font-family:'Poppins',sans-serif;font-size:clamp(68px,11vw,94px);font-weight:900;color:#fff;text-shadow:0 0 40px rgba(255,255,255,.25);line-height:1;transition:opacity .18s,transform .18s;z-index:1}
    .demo-cd-lbl{font-family:'Great Vibes',cursive;font-size:clamp(19px,3vw,25px);color:rgba(221,170,68,.9);margin-top:6px;z-index:1}
    .demo-flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none;transition:opacity .06s;z-index:5}
    .demo-compliment-wrap{display:flex;flex-direction:column;align-items:center;gap:10px;padding:20px}
    .demo-compliment-emoji{font-size:42px;animation:demoPulse 1.6s ease-in-out infinite}
    .demo-compliment-text{font-family:'Great Vibes',cursive;font-size:clamp(30px,5vw,42px);color:rgba(221,170,68,1);text-shadow:0 1px 20px rgba(221,170,68,.4);text-align:center}
    .demo-compliment-sub{font-size:10px;color:rgba(255,255,255,.35);font-family:'Poppins',sans-serif;letter-spacing:.08em;text-align:center;margin-top:4px}
    .demo-sign-wrap{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:0 22px;padding-bottom:64px}
    .demo-sign-instruction{font-size:11px;color:rgba(255,255,255,.45);font-family:'Poppins',sans-serif;letter-spacing:.07em}
    .demo-sign-area{width:100%;background:rgba(255,255,255,.03);border:1px solid rgba(221,170,68,.22);border-radius:12px;height:72px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
    .demo-sign-animated{font-family:'Great Vibes',cursive;font-size:26px;color:rgba(221,170,68,.9);text-shadow:0 0 12px rgba(221,170,68,.25);display:flex;align-items:center;padding-bottom:4px}
    .demo-sign-line-base{position:absolute;bottom:14px;left:14px;right:14px;height:1px;background:rgba(221,170,68,.18)}
    .demo-done-wrap{display:flex;flex-direction:column;align-items:center;gap:12px;padding:16px 14px;width:100%}
    .demo-done-title{font-family:'Poppins',sans-serif;font-weight:700;font-size:15px;color:#fff;text-align:center}
    .demo-done-options{display:flex;gap:10px;width:100%}
    .demo-done-option{flex:1;background:rgba(221,170,68,.09);border:1px solid rgba(221,170,68,.28);border-radius:14px;padding:14px 8px;display:flex;flex-direction:column;align-items:center;gap:5px}
    .demo-done-icon{font-size:26px}
    .demo-done-opt-label{font-family:'Poppins',sans-serif;font-size:11px;font-weight:600;color:rgba(255,255,255,.75);text-align:center}
    .demo-cta-btn{background:linear-gradient(135deg,#DDA844,#B07828);border:none;border-radius:50px;color:#1a1000;font-family:'Poppins',sans-serif;font-weight:700;font-size:12px;padding:11px 18px;cursor:pointer;width:100%;letter-spacing:.03em}
    .demo-restart-btn{background:none;border:none;color:rgba(255,255,255,.35);font-family:'Poppins',sans-serif;font-size:11px;cursor:pointer;padding:0;text-decoration:underline;text-underline-offset:2px}
    .demo-progress{position:absolute;top:12px;left:50%;transform:translateX(-50%);display:flex;gap:5px;z-index:10}
    .demo-dot{height:5px;border-radius:3px;background:rgba(255,255,255,.18);cursor:pointer;transition:background .3s,width .35s;width:5px;padding:8px;margin:-8px;box-sizing:content-box}
    .demo-dot.active{width:18px;background:rgba(221,170,68,.8)}
    .demo-nav-btn{width:44px;height:44px;border-radius:50%;background:rgba(221,170,68,.1);border:1px solid rgba(221,170,68,.28);color:rgba(221,170,68,.8);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,transform .2s;flex-shrink:0;align-self:center}
    .demo-nav-btn:hover{background:rgba(221,170,68,.2);transform:scale(1.08)}
    .demo-steps-row{display:flex;align-items:flex-start;justify-content:center;gap:clamp(6px,2vw,24px);margin-top:clamp(24px,3vw,36px);flex-wrap:wrap;padding:0 12px}
    .demo-step-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;opacity:.38;transition:opacity .3s;min-width:60px;max-width:90px}
    .demo-step-item.active{opacity:1}
