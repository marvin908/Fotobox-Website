---
import Layout from '../layouts/Layout.astro';
import GalleryStack from '../components/GalleryStack.tsx';
---
<Layout
  title="Golden Magic Mirror Fotobox Wien – Wittmann Eventbox"
  description="Die Golden Magic Mirror Fotobox für Hochzeiten, Geburtstage & Firmenfeiern in Wien. Sofortdrucke, persönliche Betreuung & Aufbau inklusive. Jetzt unverbindlich anfragen!"
  isHome={true}
>

<!-- HERO -->
<section id="hero">
  <div class="mg-stars-bg" id="heroStars"></div>
  <div class="hero-inner">
    <div class="hero-text">
      <span class="tag hfi hfi-1">Hochzeiten · Geburtstage · Firmenfeiern</span>
      <h1 class="hfi hfi-2">Ihre Gäste reden noch<br/><span><em>Wochen danach über Ihr Event.</em></span></h1>
      <p class="hero-sub hfi hfi-3">Der Magic Mirror bringt sie zum Lachen, bricht das Eis und liefert Erinnerungen, die bleiben –<br/>aufgebaut, betreut und abgebaut, ohne dass Sie einen Finger rühren.</p>
      <div class="hero-cta-row hfi hfi-4">
        <a href="#pricing" class="btn-hero-glass hfi hfi-4">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="white"/></svg>
          Wunschtermin sichern
        </a>
        <a href="#galerie" class="btn-hero-secondary hfi hfi-4">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12l7 7 7-7" stroke="rgba(255,255,255,.85)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  Zur Galerie
</a>
      </div>
    </div>
    <div class="hero-visual hfi hfi-6">
      <div class="mirror-wrap">
      <div class="mirror-ornament">
        <svg width="48" height="36" viewBox="0 0 48 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="24" y1="36" x2="24" y2="22" stroke="url(#og)" stroke-width="1"/>
          <circle cx="24" cy="19" r="2.5" fill="#DDA844" opacity=".9"/>
          <path d="M24 14 L28 8 L24 2 L20 8 Z" fill="url(#od)" opacity=".95"/>
          <path d="M12 12 L18 9 L20 3 L14 6 Z" fill="url(#od)" opacity=".7"/>
          <path d="M36 12 L30 9 L28 3 L34 6 Z" fill="url(#od)" opacity=".7"/>
          <circle cx="11" cy="13" r="1.8" fill="#E8D496" opacity=".8"/>
          <circle cx="37" cy="13" r="1.8" fill="#E8D496" opacity=".8"/>
          <defs>
            <linearGradient id="og" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#DDA844" stop-opacity="0"/>
              <stop offset="100%" stop-color="#DDA844" stop-opacity=".7"/>
            </linearGradient>
            <linearGradient id="od" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#f8e8a0"/>
              <stop offset="100%" stop-color="#b07828"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
      <div class="mirror-frame">
        <div class="mirror-screen">
          <div class="mirror-bokeh" id="mirrorBokeh"></div>
          <div class="mirror-bg">
            <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,rgba(255,255,255,.07) 0%,transparent 45%)"></div>
            <div style="position:absolute;top:12px;left:50%;transform:translateX(-50%);display:flex;gap:7px">
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.2)"></div>
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(221,170,68,.5)"></div>
              <div style="width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.2)"></div>
            </div>
          </div>
        </div>
        <div style="position:absolute;top:6%;left:12%;width:18%;height:40%;background:linear-gradient(170deg,rgba(255,255,255,.45),rgba(255,255,255,.0));border-radius:50%;pointer-events:none;transform:rotate(-15deg);filter:blur(6px)"></div>
        <div style="position:absolute;top:4%;right:18%;width:6%;height:18%;background:linear-gradient(170deg,rgba(255,255,255,.3),transparent);border-radius:50%;pointer-events:none;filter:blur(4px)"></div>
        <div class="flash-overlay" id="flashEl"></div>
        <div class="mirror-cd">
          <div class="cd-num" id="cdNum">3</div>
          <div class="cd-lbl" id="cdLbl">Lächeln!</div>
        </div>
        <div class="mirror-choice" id="mirrorChoice">
          <p class="mc-title">Ihr Foto ist bereit</p>
          <div class="mc-btns">
            <div class="mc-btn">
              <div class="mc-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="2" width="14" height="20" rx="3" stroke="#B07828" stroke-width="1.8"/><circle cx="12" cy="17" r="1.2" fill="#B07828"/><path d="M9 7h6" stroke="#B07828" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div class="mc-lbl">QR-Code</div>
              <div class="mc-sub">Digital teilen</div>
            </div>
            <div class="mc-btn mc-btn-active">
              <div class="mc-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="7" width="18" height="11" rx="2" stroke="#B07828" stroke-width="1.8"/><path d="M7 7V5a2 2 0 012-2h6a2 2 0 012 2v2" stroke="#B07828" stroke-width="1.8"/><rect x="8" y="12" width="8" height="3" rx="1" stroke="#B07828" stroke-width="1.5"/></svg>
              </div>
              <div class="mc-lbl">Sofortdruck</div>
              <div class="mc-sub">Foto mitnehmen</div>
            </div>
          </div>
        </div>
        <div class="mirror-dots"><div class="mirror-dot on"></div><div class="mirror-dot"></div><div class="mirror-dot"></div></div>
      </div>
      </div><!-- /mirror-wrap -->
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<div class="trust-bar" id="trustBar">
  <div class="tb-vignette-l"></div>
  <div class="tb-vignette-r"></div>
  <div class="marquee">
    <div class="ti">Gäste lachen ab der ersten Sekunde</div><div class="ti-sep">✦</div>
    <div class="ti">Jeder nimmt ein Foto mit nach Hause</div><div class="ti-sep">✦</div>
    <div class="ti">Null Aufwand für Sie</div><div class="ti-sep">✦</div>
    <div class="ti">Funktioniert bei jeder Altersgruppe</div><div class="ti-sep">✦</div>
    <div class="ti">Aufbau & Abbau inklusive</div><div class="ti-sep">✦</div>
    <div class="ti">Wien & Umgebung</div><div class="ti-sep">✦</div>
    <div class="ti">Persönliche Betreuung vor Ort</div><div class="ti-sep">✦</div>
    <div class="ti">Gäste lachen ab der ersten Sekunde</div><div class="ti-sep">✦</div>
    <div class="ti">Jeder nimmt ein Foto mit nach Hause</div><div class="ti-sep">✦</div>
    <div class="ti">Null Aufwand für Sie</div><div class="ti-sep">✦</div>
    <div class="ti">Funktioniert bei jeder Altersgruppe</div><div class="ti-sep">✦</div>
    <div class="ti">Aufbau & Abbau inklusive</div><div class="ti-sep">✦</div>
    <div class="ti">Wien & Umgebung</div><div class="ti-sep">✦</div>
    <div class="ti">Persönliche Betreuung vor Ort</div><div class="ti-sep">✦</div>
  </div>
</div>


<!-- GALLERY -->
<section id="galerie" style="padding:var(--section-y) 0;background:linear-gradient(to bottom,#110D04 0%,#0f0d08 20%,#0f0d08 80%,#1E1508 100%);position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 70% 50% at 50% 55%,rgba(221,170,68,.09),transparent 70%);pointer-events:none"></div>
  <div class="wrap" style="position:relative;z-index:1;text-align:center;margin-bottom:clamp(16px,3vw,32px)">
    <div class="reveal">
      <span class="tag">Social Proof</span>
      <h2 class="sec-title" style="margin:14px 0 12px;color:var(--white)">So sieht es aus, wenn<br/>Ihre Gäste loslassen.</h2>
      <p class="sec-sub" style="margin:0 auto;color:rgba(255,255,255,.6)">Echte Momente von echten Events – kein Posing, nur gute Laune.</p>
    </div>
  </div>
  <GalleryStack client:visible />
  <div class="reveal" style="text-align:center;margin-top:clamp(28px,4vw,48px);position:relative;z-index:1">
    <a href="#pricing" style="display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border:1.5px solid rgba(221,170,68,.45);border-radius:50px;font-family:'Poppins',sans-serif;font-size:15px;font-weight:600;color:var(--gold);letter-spacing:.04em;text-decoration:none;transition:background .3s,border-color .3s,box-shadow .3s" onmouseover="this.style.background='rgba(221,170,68,.08)';this.style.borderColor='rgba(221,170,68,.75)';this.style.boxShadow='0 0 24px rgba(221,170,68,.15)'" onmouseout="this.style.background='';this.style.borderColor='rgba(221,170,68,.45)';this.style.boxShadow=''">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Unsere Preise
    </a>
  </div>
</section>

<div class="sec-div" style="background:linear-gradient(180deg,#1E1508,#FAF6EE)"><span class="sec-div-gem"><span class="sec-div-gem-inner"></span></span></div>
<!-- EVENTS -->
<section id="events" style="padding:var(--section-y) 0;background:#FAF6EE;position:relative;overflow:hidden">
  <div class="wrap" style="position:relative;z-index:1">
    <div class="reveal" style="text-align:center;margin-bottom:clamp(32px,4vw,56px)">
      <span class="tag">Für jeden Anlass</span>
      <h2 class="sec-title" style="margin:14px 0 12px;color:var(--dark)">Perfekt für Ihr besonderes Event</h2>
      <p class="sec-sub" style="margin:0 auto;color:rgba(17,17,17,.6)">Ob intimes Fest oder große Feier – der Magic Mirror ist das Gesprächsthema des Abends.</p>
    </div>
    <div class="ev-rows" style="margin-top:clamp(40px,6vw,72px)">
      <div class="ev-row reveal-left">
        <div class="ev-row-num">01</div>
        <div class="ev-row-title">Hochzeit</div>
        <div class="ev-row-text">Die Stunden zwischen Dinner und Tanz? Da sorgt der Mirror dafür, dass niemand auf die Uhr schaut.</div>
      </div>
      <div class="ev-row reveal-right">
        <div class="ev-row-num">02</div>
        <div class="ev-row-title">Geburtstag</div>
        <div class="ev-row-text">Egal ob 30 oder 70 – der Mirror bringt jede Generation an einen Tisch.</div>
      </div>
      <div class="ev-row reveal-left">
        <div class="ev-row-num">03</div>
        <div class="ev-row-title">Firmenfeier</div>
        <div class="ev-row-text">Das Eis brechen, ohne Teambuilding-Spiele die niemand will.</div>
      </div>
      <div class="ev-row reveal-right">
        <div class="ev-row-num">04</div>
        <div class="ev-row-title">Jedes Event</div>
        <div class="ev-row-text">Messe, Gala, Jubiläum – ein Magnet, der Ihre Gäste zusammenbringt.</div>
      </div>
    </div>
  </div>
</section>

<!-- MAGIC -->
<section id="magic" style="padding:var(--section-y) 0;background:linear-gradient(to bottom,#2C1E08 0%,#1C1306 50%,#2C1E08 100%);position:relative;overflow:hidden">
  <div class="mg-glow"></div>
  <div class="mg-stars-bg" id="mgStars"></div>
  <div class="wrap">
    <div class="mg-hd reveal-scale">
      <span class="tag">Der Ablauf</span>
      <h2 class="sec-title" style="color:var(--white)">So funktioniert<br/><em style="font-family:'Great Vibes',cursive;font-style:normal;font-weight:400;color:var(--gold);font-size:1.7em;letter-spacing:.5px;display:inline-block;margin-top:10px">Die Magie des Spiegels</em></h2>
      <div class="mg-deco"><div class="mg-line"></div><div class="mg-stars-txt">✦ ✦ ✦</div><div class="mg-line r"></div></div>
      <p class="mg-sub">Vier Schritte – vom ersten Blick zum fertigen Foto.</p>
    </div>
    <div style="position:relative">
      <div class="tl-grid reveal-left">
        <div class="tl-conn"><div class="tl-conn-inner"></div></div>
        <div class="tl-item"><div class="tl-circ">1</div><div class="tl-item-text"><h4>Der Spiegel zieht Ihre Gäste magisch an.</h4><p>Roter Teppich, goldenes Licht – nach 10 Minuten steht die erste Schlange. Sie müssen niemanden überreden.</p></div></div>
        <div class="tl-item"><div class="tl-circ">2</div><div class="tl-item-text"><h4>Kein Gast bleibt außen vor.</h4><p>Kein Fotograf, der Posen ansagt. Der Mirror führt Ihre Gäste mit Countdown und Animationen – ganz von alleine. Selbst die Zurückhaltenden stehen plötzlich in Reihe zwei.</p></div></div>
        <div class="tl-item"><div class="tl-circ">3</div><div class="tl-item-text"><h4>Jedes Foto wird zum Unikat.</h4><p>Emojis, Unterschriften, persönliche Rahmen – direkt am Spiegel. In Sekunden, ohne App.</p></div></div>
        <div class="tl-item"><div class="tl-circ">4</div><div class="tl-item-text"><h4>Jeder Gast geht mit einer Erinnerung nach Hause.</h4><p>Sofortdruck zum Mitnehmen plus QR-Code fürs Handy. Das Foto hängt am nächsten Tag am Kühlschrank.</p></div></div>
      </div>
    </div>
    <div style="text-align:center;margin-top:clamp(40px,5vw,64px)" class="reveal">
      <button class="btn-gold" onclick="goContact('')">Spiegel unverbindlich reservieren</button>
    </div>
  </div>
</section>

<!-- BENEFITS -->
<section id="why" style="padding:var(--section-y) 0;background:#FAF6EE;position:relative;overflow:hidden">
  <div class="wrap" style="position:relative;z-index:1">

    <div class="reveal-right" style="margin-bottom:clamp(48px,6vw,72px)">
      <span class="tag">Mehr als eine Fotobox</span>
      <h2 class="sec-title" style="margin:14px 0 0;color:var(--dark)">Deswegen wählen unsere<br/>Kunden den Magic Mirror</h2>
    </div>

    <div class="ben-feat-rows">

      <div class="ben-feat-row reveal-left d1">
        <div class="ben-feat-icon">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6L12 2z" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linejoin="round"/></svg>
        </div>
        <div class="ben-feat-content">
          <div class="ben-feat-label">01 — Erinnerung</div>
          <h3 class="ben-feat-title">Echte Fotos statt gestellter Gruppenbilder.</h3>
          <p class="ben-feat-text">Ihre Gäste lachen, albern rum, sind sie selbst – der Sofortdruck ist ein Andenken, das sie tatsächlich behalten.</p>
        </div>
        <div class="ben-feat-num">01</div>
      </div>

      <div class="ben-feat-row reveal-right d2">
        <div class="ben-feat-icon">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="var(--gold-dark)" stroke-width="1.7"/><path d="M8 14s1.5 2 4 2 4-2 4-2" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/><circle cx="9" cy="10" r="1.2" fill="var(--gold-dark)"/><circle cx="15" cy="10" r="1.2" fill="var(--gold-dark)"/></svg>
        </div>
        <div class="ben-feat-content">
          <div class="ben-feat-label">02 — Unterhaltung</div>
          <h3 class="ben-feat-title">Der Programmpunkt, den Sie nicht planen müssen.</h3>
          <p class="ben-feat-text">Der Mirror läuft von alleine. Countdown, Animation, Druck – Ihre Gäste brauchen keine Erklärung. Sie stellen sich einfach davor.</p>
        </div>
        <div class="ben-feat-num">02</div>
      </div>

      <div class="ben-feat-row reveal-left d3">
        <div class="ben-feat-icon">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20 12v9H4v-9" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/><path d="M22 7H2v5h20V7z" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/><path d="M12 22V7" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" stroke="var(--gold-dark)" stroke-width="1.7" stroke-linecap="round"/></svg>
        </div>
        <div class="ben-feat-content">
          <div class="ben-feat-label">03 — Gastgeschenk</div>
          <h3 class="ben-feat-title">Jeder Gast nimmt Ihr Event mit nach Hause.</h3>
          <p class="ben-feat-text">Ein echter Fotoabzug, kein digitaler Schnappschuss der im Handy verschwindet. Das hängt am Kühlschrank, steht im Regal – und erinnert an Ihren Abend.</p>
        </div>
        <div class="ben-feat-num">03</div>
      </div>

    </div>
  </div>
</section>

<!-- PRICING -->
<section id="pricing" style="padding:var(--section-y) 0;background:linear-gradient(to bottom,#0a0806 0%,#0f0d08 100%);position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 90% 55% at 50% 50%,rgba(221,170,68,.06),transparent 75%);pointer-events:none"></div>
  <div class="wrap">
    <div class="reveal" style="text-align:center;margin:0 auto clamp(40px,5vw,64px)">
      <span class="tag">Wählen Sie Ihr Paket</span>
      <h2 class="sec-title" style="margin:14px 0 12px;color:var(--white)">Alles drin. Liefern,<br/>aufbauen, abbauen – das machen wir.</h2>
      <p style="font-size:clamp(14px,1.6vw,16px);color:rgba(255,255,255,.6);line-height:1.7">Sie wählen Ihr Paket, wir liefern das Erlebnis. Preise inkl. MwSt., keine versteckten Kosten.</p>
    </div>
    <div class="pr2-grid">

      <!-- KLASSISCH -->
      <div class="pr2-card reveal-scale d1">
        <div class="pr2-top">
          <div>
            <div class="pr2-tier">Klassisch</div>
            <div class="pr2-desc">Perfekter Einstieg für kleinere Events</div>
          </div>
          <div class="pr2-price-wrap">
            <div class="pr2-price"><sup>€</sup>500</div>
            <div class="pr2-vat">inkl. MwSt.</div>
          </div>
        </div>
        <div class="pr2-divider"></div>
        <div class="pr2-feat-label">Inklusive</div>
        <ul class="pr2-feats">
          <li><span class="pr2-ck">✓</span>Anfahrt inklusive</li>
          <li><span class="pr2-ck">✓</span>400 Sofortdrucke</li>
          <li><span class="pr2-ck">✓</span>Roter Teppich & goldene Stangen</li>
          <li><span class="pr2-ck">✓</span>Party-Equipment (Brillen, Hüte, Masken)</li>
          <li><span class="pr2-ck">✓</span>Profi LED-Ringlicht</li>
          <li><span class="pr2-x">✗</span><span style="color:#bbb">LED-Seifenblasenmaschinen</span></li>
          <li><span class="pr2-x">✗</span><span style="color:#bbb">LED-Rauchmaschinen</span></li>
        </ul>
        <button class="pr2-btn" onclick="goContact('Basis')">Unverbindlich anfragen</button>
      </div>

      <!-- PREMIUM -->
      <div class="pr2-card pr2-featured reveal-scale d2">
        <div class="pr2-badge">✦ Beliebteste Wahl</div>
        <div class="pr2-top">
          <div>
            <div class="pr2-tier" style="color:var(--gold)">Premium</div>
            <div class="pr2-desc" style="color:rgba(255,255,255,.6)">+ Seifenblasenmaschinen</div>
          </div>
          <div class="pr2-price-wrap">
            <div class="pr2-price" style="color:var(--white)"><sup style="color:var(--gold-light)">€</sup>650</div>
            <div class="pr2-vat" style="color:rgba(255,255,255,.45)">inkl. MwSt.</div>
          </div>
        </div>
        <div class="pr2-divider" style="background:rgba(221,170,68,.2)"></div>
        <div class="pr2-feat-label" style="color:rgba(255,255,255,.5)">Inklusive</div>
        <ul class="pr2-feats">
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">Anfahrt inklusive</span></li>
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">400 Sofortdrucke</span></li>
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">Roter Teppich & goldene Stangen</span></li>
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">Party-Equipment (Brillen, Hüte, Masken)</span></li>
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">Profi LED-Ringlicht</span></li>
          <li><span class="pr2-ck">✓</span><span style="color:rgba(255,255,255,.85)">2× LED-Seifenblasenmaschinen <span style="font-size:12px;opacity:.6">(4L Flüssigkeit)</span></span></li>
          <li><span class="pr2-x" style="color:rgba(255,255,255,.2)">✗</span><span style="color:rgba(255,255,255,.3)">LED-Rauchmaschinen</span></li>
        </ul>
        <button class="pr2-btn pr2-btn-featured" onclick="goContact('Premium')">Unverbindlich anfragen</button>
      </div>

      <!-- DELUXE -->
      <div class="pr2-card pr2-deluxe reveal-scale d3">
        <div class="pr2-deluxe-badge">✦ Exklusiv</div>
        <div class="pr2-top">
          <div>
            <div class="pr2-tier" style="color:var(--gold-light)">Deluxe</div>
            <div class="pr2-desc" style="color:rgba(255,255,255,.6)">+ Seifenblasenmaschinen<br/>+ Rauchmaschinen</div>
          </div>
          <div class="pr2-price-wrap">
