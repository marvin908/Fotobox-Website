---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Vielen Dank – Wittmann Eventbox"
  description="Ihre Anfrage wurde erfolgreich übermittelt. Wir melden uns innerhalb von 24 Stunden."
  robots="noindex,nofollow"
>

<style>
.danke-wrap{min-height:70vh;display:flex;align-items:center;justify-content:center;padding:clamp(48px,8vw,96px) 20px;background:linear-gradient(160deg,#1a1206 0%,#0f0d08 50%,#1a1206 100%);position:relative;overflow:hidden}
.danke-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:min(700px,90%);height:500px;background:radial-gradient(ellipse,rgba(221,170,68,.14),transparent 65%);pointer-events:none}
.danke-card{position:relative;z-index:1;text-align:center;max-width:560px}
.danke-check{width:72px;height:72px;border-radius:50%;background:rgba(34,197,94,.15);border:2px solid rgba(34,197,94,.4);display:flex;align-items:center;justify-content:center;margin:0 auto 28px;font-size:28px;color:#4ade80}
.danke-tag{display:inline-block;background:rgba(221,170,68,.15);color:var(--gold);border:1px solid rgba(221,170,68,.4);font-family:'Mulish',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;padding:6px 16px;border-radius:20px;margin-bottom:20px}
.danke-h1{font-family:'Poppins',sans-serif;font-size:clamp(26px,4vw,40px);font-weight:800;color:var(--white);line-height:1.2;margin-bottom:8px}
.danke-h1 em{font-family:'Great Vibes',cursive;font-style:normal;font-weight:400;color:var(--gold);font-size:1.4em;display:block;margin-top:6px}
.danke-sub{font-size:clamp(15px,1.8vw,17px);color:rgba(255,255,255,.65);line-height:1.7;margin:16px 0 32px}
.danke-promises{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:36px;text-align:left}
.danke-promises li{display:flex;align-items:center;gap:12px;font-size:15px;color:rgba(255,255,255,.75)}
.danke-dot{width:8px;height:8px;border-radius:50%;background:var(--gold);flex-shrink:0;box-shadow:0 0 8px rgba(221,170,68,.4)}
.danke-btns{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}
.danke-contact{margin-top:28px;font-size:13px;color:rgba(255,255,255,.35)}
.danke-contact a{color:rgba(221,170,68,.7);text-decoration:none}
.danke-contact a:hover{color:var(--gold)}
</style>

<div class="danke-wrap">
  <div class="danke-glow"></div>
  <div class="danke-card">
    <div class="danke-check">✓</div>
    <span class="danke-tag">Anfrage erhalten</span>
    <h1 class="danke-h1">
      Vielen Dank!
      <em>Wir melden uns bald.</em>
    </h1>
    <p class="danke-sub">
      Ihre Anfrage ist bei uns eingegangen. Wir antworten innerhalb von <strong style="color:rgba(255,255,255,.9)">24 Stunden</strong> – persönlich, kein Autoresponder.
    </p>
    <ul class="danke-promises">
      <li><div class="danke-dot"></div>Persönliche Rückmeldung – kein automatisches System</li>
      <li><div class="danke-dot"></div>Völlig unverbindlich – keine Verpflichtung</li>
      <li><div class="danke-dot"></div>Wir beraten Sie zur besten Option für Ihr Event</li>
    </ul>
    <div class="danke-btns">
      <a href="/" class="btn-gold">← Zurück zur Startseite</a>
    </div>
    <p class="danke-contact">
      Dringende Fragen? <a href="tel:+436604313993">0660 431 39 93</a> · <a href="mailto:wb@wittmann-eventbox.at">wb@wittmann-eventbox.at</a>
    </p>
  </div>
</div>

<script is:inline>
if(typeof gtag!=='undefined'){
  gtag('event','conversion',{'send_to':'AW-10978741779/nIlECMfuypkcEJOcifMo'});
}
</script>

</Layout>
